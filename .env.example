# Copier ce fichier en .env et renseigner les valeurs. Le fichier .env n'est jamais commité.
# Aucune valeur par défaut n'existe dans le code : une variable absente empêche le démarrage.

# Racine de l'API eCare+, appelée par le navigateur.
# - En développement : /api/v1 (chemin relatif, relayé par Vite vers VITE_DEV_PROXY_TARGET).
# - En production : l'URL publique du backend, par exemple https://api.exemple.test/api/v1
# Attention : cette valeur est figée dans les fichiers au moment du build.
VITE_API_URL=/api/v1

# Adresse du backend vers laquelle Vite relaie `/api` en développement (npm run dev uniquement).
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Source des données de l'application :
# - demo : base locale du navigateur, avec un jeu de données complet (aucun backend nécessaire) ;
# - api : backend eCare+ à l'adresse VITE_API_URL (seule l'authentification y est branchée pour l'instant).
VITE_DATA_SOURCE=demo
